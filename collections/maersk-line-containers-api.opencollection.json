{
  "opencollection": "1.0.0",
  "info": {
    "name": "Maersk Air Booking AirBookings Containers API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Consumer-Key",
      "value": "{{Consumer-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Containers",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Supported Containers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.maersk.com/offers/v2/offers/containers"
          },
          "docs": "List all container size-types supported for offers."
        }
      ]
    }
  ],
  "bundled": true
}